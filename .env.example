# Server-side variables for the Next.js app. Never commit real values.
# (.env* is gitignored except this example.)

# API origin used by the admin proxy (/api/v1) and the customer BFF (/api/store).
# Defaults to the production API when unset.
BACKEND_URL=http://localhost:3001

# Browser base URL for the existing admin axios client (the proxy path).
NEXT_PUBLIC_API_URL=/api/v1

# ── Storefront (off by default; production is unchanged while false) ──
# See docs/STOREFRONT_ROUTING.md.
STOREFRONT_ENABLED=false
# At least 32 characters. Must equal BFF_SHARED_SECRET on the API.
BFF_SHARED_SECRET=
# Optional customer-facing origin, e.g. https://shop.example.com
STOREFRONT_PUBLIC_URL=
