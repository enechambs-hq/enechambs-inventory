# Server-side variables for the Next.js app. Never commit real values.
# (.env* is gitignored except this example.)

# API origin used by the admin proxy (/api/v1) and the customer BFF (/api/store).
# Defaults to the production API when unset.
BACKEND_URL=http://localhost:3001

# Browser base URL for the existing admin axios client (the proxy path).
NEXT_PUBLIC_API_URL=/api/v1

# ── Storefront (off by default; production is unchanged while false) ──
# See docs/STOREFRONT_ROUTING.md.
STOREFRONT_ENABLED=false
# At least 32 characters. Must equal BFF_SHARED_SECRET on the API.
BFF_SHARED_SECRET=
# Optional customer-facing origin, e.g. https://shop.example.com
STOREFRONT_PUBLIC_URL=

# ── Error monitoring (Sentry). Optional: nothing is sent unless a DSN is set. See docs/MONITORING.md ──
# Server (route handlers, rendering, the staff proxy). Vercel: Project Settings > Environment Variables.
SENTRY_DSN=
# Browser. A DSN is a public, write-only identifier by design; it is inlined at build time.
NEXT_PUBLIC_SENTRY_DSN=
# Optional overrides. Defaults: environment = Vercel's VERCEL_ENV, release = VERCEL_GIT_COMMIT_SHA.
SENTRY_ENVIRONMENT=
SENTRY_RELEASE=
# 0 to 0.2 (default 0.05). The browser variant is NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE.
SENTRY_TRACES_SAMPLE_RATE=
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# Build-time only, to upload source maps. Never expose these to the browser. Without all three, nothing is uploaded.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
